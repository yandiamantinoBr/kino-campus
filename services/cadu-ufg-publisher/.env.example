# Copy to .env.local on the VPS. Never commit .env.local.
CADU_SUPABASE_URL=
CADU_SUPABASE_ANON_KEY=
CADU_KINO_EMAIL=
CADU_KINO_PASSWORD=

# Telegram alerts
CADU_TELEGRAM_BOT_TOKEN=
CADU_TELEGRAM_CHAT_ID=

# Email alerts: use Resend or a webhook.
CADU_RESEND_API_KEY=
CADU_EMAIL_FROM=Kino Campus <contato@kinocampus.com.br>
CADU_EMAIL_TO=contato@kinocampus.com.br
CADU_EMAIL_WEBHOOK_URL=

# Optional DeepSeek/OpenAI-compatible summarization.
CADU_USE_MODEL=false
CADU_DEEPSEEK_API_KEY=
CADU_DEEPSEEK_MODEL=deepseek-v4-flash
CADU_DEEPSEEK_BASE_URL=https://api.deepseek.com
CADU_DEEPSEEK_ENDPOINT=

# Runtime controls
CADU_MAX_ITEMS_PER_SOURCE=15
CADU_MAX_PUBLISH_PER_RUN=3
CADU_MAX_PDF_BYTES=26214400
# Optional. On Ubuntu install poppler-utils and leave this as pdftotext.
CADU_PDFTOTEXT_PATH=pdftotext
CADU_MIN_DELAY_MS=900
CADU_REQUEST_TIMEOUT_MS=20000
CADU_USER_AGENT=CaduKinoCampusBot/1.0 (+contato@kinocampus.com.br)
