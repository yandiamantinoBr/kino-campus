{
  "name": "kino-campus",
  "version": "1.0.0",
  "description": "Este repositorio e o prototipo web offline-first do Kino Campus, em baseline v75.1 performance phase 1 com runtime canonico de frontend 8.6.1.",
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "jest",
    "test:cache-artifact": "jest tests/integration/asset-cache-bust.test.js tests/unit/sw.test.js --runInBand",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:e2e:report": "node node_modules/@playwright/test/cli.js show-report output/playwright-report",
    "lhci": "lhci autorun",
    "check:hygiene": "node scripts/hygiene-check.js",
    "seo:audit": "node scripts/seo-audit.js",
    "analytics:secrets:set": "node scripts/set-google-analytics-secrets.js",
    "check:structure": "node scripts/validate-repository-structure.js",
    "check:scripts": "node scripts/validate-script-chains.js",
    "check:routes": "node scripts/validate-public-routes.js",
    "check:version": "node scripts/validate-version-map.js",
    "check:dist-cache": "node scripts/static-cache-revision.js --check dist",
    "check:all": "npm run check:version && npm run check:structure && npm run check:scripts && npm run check:routes && npm run check:hygiene && npm run check:search-registry && npm run cadu:sources:check && npm test",
    "audit:css": "node scripts/audit-css-ownership.js",
    "audit:css-baseline": "node scripts/capture-css-visual-baseline.js",
    "audit:kcapi-residual": "node scripts/audit-kcapi-facade-residual.js",
    "benchmark:search-shadow": "node scripts/benchmark-search-shadow.js",
    "benchmark:feed-ranking-shadow": "node scripts/analyze-feed-ranking-shadow.js",
    "generate:search-registry": "node scripts/generate-search-registry-snapshot.js",
    "check:search-registry": "node scripts/generate-search-registry-snapshot.js --check",
    "cadu:dry-run": "node services/cadu-ufg-publisher/src/cli.js --dry-run --mode=quick",
    "cadu:dry-run:full": "node services/cadu-ufg-publisher/src/cli.js --dry-run --mode=full",
    "cadu:curator:relevance-report": "node scripts/evaluate-cadu-curator-relevance.js",
    "cadu:sources:check": "node services/cadu-ufg-publisher/scripts/sync-candidate-source-registry.js --check",
    "cadu:publish:quick": "node services/cadu-ufg-publisher/src/cli.js --publish --mode=quick",
    "cadu:publish:full": "node services/cadu-ufg-publisher/src/cli.js --publish --mode=full",
    "cadu:reviews": "node services/cadu-ufg-publisher/src/reviews.js",
    "cadu:refresh-cache": "node services/cadu-ufg-publisher/scripts/regenerate-posts-cache.js",
    "test:cadu": "jest tests/unit/cadu-ufg-publisher.test.js tests/unit/cadu-openclaw-curator.test.js --runInBand",
    "test:cadu:registry": "jest tests/unit/cadu-candidate-source-registry.test.js --runInBand",
    "test:cadu:phase-a-upgrade": "node scripts/test-cadu-phase-a-legacy-upgrade.js",
    "test:cadu:phase-a-postgrest": "node scripts/test-cadu-phase-a-postgrest.js",
    "test:db:audited-category-metadata": "node scripts/test-audited-category-metadata-reconciliation.js",
    "test:db:canonical-category-labels": "node scripts/test-canonical-category-label-reconciliation.js",
    "test:db:canonical-category-labels:cli-push": "node scripts/test-canonical-category-label-reconciliation-cli-push.js",
    "test:db:canonical-category-labels:reset-local": "node scripts/test-canonical-category-label-reconciliation.js --supabase-reset",
    "test:db:semantic-post-reclassification": "node scripts/test-semantic-post-reclassification.js",
    "cadu:audit": "node tests/manual/cadu-site-health-probe.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yandiamantinoBr/kino-campus.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/yandiamantinoBr/kino-campus/issues"
  },
  "homepage": "https://github.com/yandiamantinoBr/kino-campus#readme",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^1.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "babel-jest": "^30.3.0",
    "http-server": "^14.1.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^26.1.0"
  },
  "overrides": {
    "tmp": "0.2.7",
    "body-parser": "1.20.6",
    "brace-expansion": "5.0.9",
    "fast-uri": "^4.1.0",
    "glob": "13.0.6",
    "test-exclude": "8.0.0",
    "chrome-launcher": "1.2.1",
    "ip-address": "10.4.0",
    "socks": "2.8.9",
    "@puppeteer/browsers": "3.2.0",
    "@vercel/og": {
      "sharp": "0.35.3"
    },
    "@lhci/cli": {
      "uuid": "11.1.1"
    },
    "babel-preset-current-node-syntax": {
      "@babel/core": "^7.29.0"
    }
  }
}
