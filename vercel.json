{
  "buildCommand": "node scripts/inject-env.js",
  "installCommand": "npm ci --omit=dev --no-audit --no-fund",
  "outputDirectory": "dist",
  "functions": {
    "api/og-product.js": {
      "includeFiles": "{_product.html,404.html}"
    },
    "api/cadu/sites.js": {
      "includeFiles": "services/cadu-ufg-publisher/config/cadu-source-registry/*.json"
    }
  },
  "redirects": [
    {
      "source": "/login.html",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/eventos.html",
      "destination": "/eventos",
      "permanent": true
    },
    {
      "source": "/oportunidades.html",
      "destination": "/oportunidades",
      "permanent": true
    },
    {
      "source": "/moradia.html",
      "destination": "/moradia",
      "permanent": true
    },
    {
      "source": "/compra-venda-feed.html",
      "destination": "/compra-venda",
      "permanent": true
    },
    {
      "source": "/caronas-feed.html",
      "destination": "/caronas",
      "permanent": true
    },
    {
      "source": "/achados-perdidos.html",
      "destination": "/achados-perdidos",
      "permanent": true
    },
    {
      "source": "/create-post.html",
      "destination": "/criar-post",
      "permanent": true
    },
    {
      "source": "/profile.html",
      "destination": "/perfil",
      "permanent": true
    },
    {
      "source": "/my-posts.html",
      "destination": "/meus-posts",
      "permanent": true
    },
    {
      "source": "/settings.html",
      "destination": "/configuracoes",
      "permanent": true
    },
    {
      "source": "/search-results.html",
      "destination": "/busca",
      "permanent": true
    },
    {
      "source": "/ajuda.html",
      "destination": "/ajuda",
      "permanent": true
    },
    {
      "source": "/sobre.html",
      "destination": "/sobre",
      "permanent": true
    },
    {
      "source": "/editorial.html",
      "destination": "/editorial",
      "permanent": true
    },
    {
      "source": "/transparencia.html",
      "destination": "/transparencia",
      "permanent": true
    },
    {
      "source": "/privacidade.html",
      "destination": "/privacidade",
      "permanent": true
    },
    {
      "source": "/termos.html",
      "destination": "/termos",
      "permanent": true
    },
    {
      "source": "/ods.html",
      "destination": "/ods",
      "permanent": true
    },
    {
      "source": "/account-setup.html",
      "destination": "/conta",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pitch",
      "destination": "/apresentacao-institucional.html",
      "permanent": true
    },
    {
      "source": "/apresentacao",
      "destination": "/apresentacao-institucional.html",
      "permanent": true
    },
    {
      "source": "/apresentacao-institucional",
      "destination": "/apresentacao-institucional.html",
      "permanent": true
    },
    {
      "source": "/admin/ga4/dashboard.html",
      "destination": "/admin/ga4-dashboard.html",
      "permanent": true
    },
    {
      "source": "/admin/ga4/dashboard",
      "destination": "/admin/ga4-dashboard.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/404.html",
      "destination": "/api/og-product?kc_not_found=1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    },
    {
      "source": "/product.html",
      "destination": "/api/og-product"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/eventos",
      "destination": "/eventos.html"
    },
    {
      "source": "/oportunidades",
      "destination": "/oportunidades.html"
    },
    {
      "source": "/moradia",
      "destination": "/moradia.html"
    },
    {
      "source": "/compra-venda",
      "destination": "/compra-venda-feed.html"
    },
    {
      "source": "/caronas",
      "destination": "/caronas-feed.html"
    },
    {
      "source": "/achados-perdidos",
      "destination": "/achados-perdidos.html"
    },
    {
      "source": "/criar-post",
      "destination": "/create-post.html"
    },
    {
      "source": "/perfil",
      "destination": "/profile.html"
    },
    {
      "source": "/meus-posts",
      "destination": "/my-posts.html"
    },
    {
      "source": "/configuracoes",
      "destination": "/settings.html"
    },
    {
      "source": "/busca",
      "destination": "/search-results.html"
    },
    {
      "source": "/ajuda",
      "destination": "/ajuda.html"
    },
    {
      "source": "/sobre",
      "destination": "/sobre.html"
    },
    {
      "source": "/editorial",
      "destination": "/editorial.html"
    },
    {
      "source": "/transparencia",
      "destination": "/transparencia.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/termos",
      "destination": "/termos.html"
    },
    {
      "source": "/ods",
      "destination": "/ods.html"
    },
    {
      "source": "/conta",
      "destination": "/account-setup.html"
    },
    {
      "source": "/pitch",
      "destination": "/apresentacao-institucional.html"
    },
    {
      "source": "/apresentacao",
      "destination": "/apresentacao-institucional.html"
    },
    {
      "source": "/apresentacao-institucional",
      "destination": "/apresentacao-institucional.html"
    },
    {
      "source": "/mensagens",
      "destination": "/mensagens.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/auth-callback.html"
    },
    {
      "source": "/api/cadu/source-reviews",
      "destination": "/api/cadu/sites?path=source-reviews"
    },
    {
      "source": "/api/cadu/reviews",
      "destination": "/api/cadu/sites?path=reviews"
    },
    {
      "source": "/api/cadu/reviews/(.+)",
      "destination": "/api/cadu/sites?path=reviews/$1"
    },
    {
      "source": "/api/cadu/sites/(.+)",
      "destination": "/api/cadu/sites?path=$1"
    },
    {
      "source": "/api/cadu/pipeline/(.+)",
      "destination": "/api/cadu/pipeline-router?path=$1"
    },
    {
      "source": "/api/cadu/openclaw/(.+)",
      "destination": "/api/cadu/openclaw-router?path=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/og-product?kc_not_found=1"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://challenges.cloudflare.com https://www.googletagmanager.com https://pagead2.googlesyndication.com https://tpc.googlesyndication.com https://securepubads.g.doubleclick.net https://partner.googleadservices.com https://www.googleadservices.com https://cdn.vercel-insights.com https://va.vercel-scripts.com; script-src-elem 'self' https://cdn.jsdelivr.net https://challenges.cloudflare.com https://www.googletagmanager.com https://pagead2.googlesyndication.com https://tpc.googlesyndication.com https://securepubads.g.doubleclick.net https://partner.googleadservices.com https://www.googleadservices.com https://cdn.vercel-insights.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://cdn.jsdelivr.net https://challenges.cloudflare.com https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://pagead2.googlesyndication.com https://securepubads.g.doubleclick.net https://partner.googleadservices.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com https://vitals.vercel-insights.com https://cdn.vercel-insights.com https://api.openclaw-hahq.srv1597083.hstgr.cloud; frame-src 'self' https://challenges.cloudflare.com https://kino-campus-pitch.vercel.app https://*.vercel.app https://*.chatgpt.site https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://securepubads.g.doubleclick.net https://www.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
