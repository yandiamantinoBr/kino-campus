# KinoCampus — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais no repositório.
#
# Como usar:
#   cp .env.example .env
#   Preencha os valores abaixo com as credenciais do seu projeto Supabase.
#   Execute: node scripts/inject-env.js  (substitui os placeholders nos arquivos de build)
#
# Referência: assets/js/kc-env.js (fonte única de verdade de configuração)

# -----------------------------------------------------------------------
# Ambiente da aplicação
# Opções: "development" | "production"
# -----------------------------------------------------------------------
KC_APP_ENV=development

# -----------------------------------------------------------------------
# Driver de dados
# Opções: "local" (sem Supabase, usa localStorage) | "supabase"
# Em produção, apenas "supabase" é aceito.
# -----------------------------------------------------------------------
KC_DRIVER=supabase

# -----------------------------------------------------------------------
# Supabase — Credenciais do projeto
# Encontre em: https://supabase.com/dashboard → seu projeto → Settings → API
# -----------------------------------------------------------------------
KC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
KC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
