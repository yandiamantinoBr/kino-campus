# KinoCampus — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais no repositório.
#
# Como usar:
#   cp .env.example .env
#   Preencha os valores abaixo com as credenciais do seu projeto Supabase.
#   Execute: node scripts/inject-env.js  (substitui os placeholders nos arquivos de build)
#
# Referência: assets/js/kc-env.js (fonte única de verdade de configuração)

# -----------------------------------------------------------------------
# Ambiente da aplicação
# Opções: "development" | "production"
# -----------------------------------------------------------------------
KC_APP_ENV=development

# -----------------------------------------------------------------------
# Driver de dados
# Opções: "local" (sem Supabase, usa localStorage) | "supabase"
# Em produção, apenas "supabase" é aceito.
# -----------------------------------------------------------------------
KC_DRIVER=supabase

# -----------------------------------------------------------------------
# Supabase — Credenciais do projeto
# Encontre em: https://supabase.com/dashboard → seu projeto → Settings → API
# -----------------------------------------------------------------------
KC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
KC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
KC_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Runtime da Edge Function cadu-publish. Aceita valores entre 0 e 1;
# ausente ou invalido preserva o fallback seguro 0.70.
AUTO_PUBLISH_SCORE_MIN=0.70
# O proxy admin Cadu também aceita os aliases server-side:
# SUPABASE_URL / VITE_SUPABASE_URL e
# SUPABASE_ANON_KEY / SUPABASE_PUBLISHABLE_KEY / VITE_SUPABASE_ANON_KEY.

# -----------------------------------------------------------------------
# Cadu (OpenClaw) — proxy da cadu-api VPS Hostinger
# Servidor FastAPI em srv1597083.hstgr.cloud. Token gerado por `openssl rand -hex 32`.
# Endpoints expostos no Vercel:
#   /api/cadu/health
#   /api/cadu/sites e /api/cadu/sites/{unit}/meta
#   /api/cadu/feed
#   /api/cadu/publish
#   /api/cadu/pipeline/*
#   /api/cadu/openclaw/*
# O browser nunca deve receber CADU_API_TOKEN. Exceto health, essas rotas
# devem validar JWT Supabase de admin antes de encaminhar para a VPS.
# -----------------------------------------------------------------------
CADU_API_URL=https://api.openclaw-hahq.srv1597083.hstgr.cloud
CADU_API_TOKEN=<preencher com token da cadu-api — NUNCA expor no chat>
# Segredo HMAC exclusivo das decisões da fila editorial. Gere outro valor com
# `openssl rand -hex 32`, configure o mesmo valor na Vercel e na VPS, mantenha-o
# entre 32 e 1.024 bytes sem whitespace/controles e nunca reutilize CADU_API_TOKEN.
CADU_REVIEW_SIGNING_SECRET=<preencher com segredo HMAC distinto — NUNCA expor no chat>

# Conta do Cadu no Supabase Auth (user_id = 2345582d-8bf7-4393-aa0d-f9953d0e02ca)
# Usada por cadu-api v0.3.1 pra fazer login (signInWithPassword) e obter JWT
# do usuário, que então é passado pra Edge Function cadu-publish (que valida o JWT
# contra a allowlist public.kc_trusted_publishers).
# ⚠️ Esses valores DEVEM estar idênticos no /docker/openclaw-hahq/.env da VPS.
# Encontre em: Supabase Dashboard → Authentication → Users → cadu@kinocampus → Reset password
CADU_KINO_EMAIL=<email da conta Cadu>
CADU_KINO_PASSWORD=<senha da conta Cadu — NUNCA expor no chat>

# -----------------------------------------------------------------------
# Vercel CLI (opcional, só para deploy local via `vercel` CLI)
# Crie em: https://vercel.com/account/tokens
# -----------------------------------------------------------------------
VERCEL_TOKEN=<seu vercel token pessoal>

# -----------------------------------------------------------------------
# Notas de segurança
# -----------------------------------------------------------------------
# - .env / .env.* estão no .gitignore (commit prevention ativo desde jun/2026)
# - Tokens expostos no chat foram revogados/pendentes de rotação
# - Para gerar token seguro: openssl rand -hex 32
# - VPS OpenClaw: srv1597083.hstgr.cloud (Ubuntu 24.04, Docker + Traefik)
#   Acesse via: ssh -i ~/.ssh/openclaw_vps root@187.77.37.25
